    local function Part(Name, Pos, Size, Color, Radius, Rotation, Transparency)
      local Obj = Custom:Create("Frame", {
        Name = Name,
        BackgroundColor3 = Color or White,
        BackgroundTransparency = Transparency or 0,
        BorderSizePixel = 0,
        Position = Pos,
        Size = Size,
        Rotation = Rotation or 0,
        ZIndex = Z
