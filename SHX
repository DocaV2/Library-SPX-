    ConfirmFrame.Size = ConfirmCardSmallSize
    ConfirmFrame.BackgroundTransparency = 1
    ConfirmShadow.ImageTransparency = 1

    TweenService:Create(ConfirmOverlay, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
      BackgroundTransparency = 0.46
    }):Play()
    TweenService:Create(ConfirmShadow, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
      ImageTransparency = 0.48
    }):Play()
    TweenService:Create(ConfirmFrame, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
