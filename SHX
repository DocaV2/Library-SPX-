          local TitleWidth = math.max(DropdownTitle.AbsoluteSize.X, 1)
          local ContentWidth = math.max(DropdownContent.AbsoluteSize.X, 1)
          local TitleLines = math.max(1, math.ceil(DropdownTitle.TextBounds.X / TitleWidth))
          local ContentLines = math.max(1, math.ceil(DropdownContent.TextBounds.X / ContentWidth))

          DropdownTitle.Size = UDim2.new(1, -180, 0, 13 * TitleLines)
          DropdownContent.Position = UDim2.new(0, 10, 0, 10 + (13 * TitleLines) + 3)
          DropdownContent.Size = UDim2.new(1, -180, 0, 12 * ContentLines)
          Dropdown.Size = UDim2.new(1, 0, 0, 28 + (13 * TitleLines) + (12 * ContentLines))
        end

