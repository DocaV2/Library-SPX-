    Beauty.SoftGlow = Value and true or false
    local Transparency = Beauty.SoftGlow and 0.02 or 1
    for _, Holder in ipairs(SpeedHubXGui:GetDescendants()) do
      if Holder.Name == "RedCornerGlow" then
        for _, Line in ipairs(Holder:GetChildren()) do
          if Line:IsA("Frame") then
            TweenService:Create(Line, TweenInfo.new(0.2), {BackgroundTransparency = Transparency}):Play()
