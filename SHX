--// Doca V1 hard runtime cleanup
--// Fixes stuck old Auto Kill / Auto Kill In Part / Ring Aura after re-execute.
local function DocaHardRuntimeCleanup()
  pcall(function()
    _G.DocaV1_AutoKillActive = false

    if _G.DocaV1_AutoKillConnections then
      for _, Connection in pairs(_G.DocaV1_AutoKillConnections) do
        pcall(function()
          if Connection and Connection.Disconnect then
            Connection:Disconnect()
          end
        end)
      end
    end
    _G.DocaV1_AutoKillConnections = {}

    if _G.DocaV1_AutoKillReturnCFrame and Player.Character then
      local Root = Player.Character:FindFirstChild("HumanoidRootPart")
      if Root then
        Root.CFrame = _G.DocaV1_AutoKillReturnCFrame
        Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        Root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        Root.Velocity = Vector3.new(0, 0, 0)
        Root.RotVelocity = Vector3.new(0, 0, 0)
      end
    end
    _G.DocaV1_AutoKillReturnCFrame = nil

    local OldPart = workspace:FindFirstChild("DocaV1_AutoKillInPart")
    if OldPart then
      OldPart:Destroy()
    end

    _G.showDeathRing = false
    if _G.visualizerConnection then
      _G.visualizerConnection:Disconnect()
      _G.visualizerConnection = nil
    end
    if _G.deathRingFolder then
      _G.deathRingFolder:Destroy()
      _G.deathRingFolder = nil
    end
    local OldRing = workspace:FindFirstChild("DeathRingVisualizer")
    if OldRing then
      OldRing:Destroy()
    end
    _G.ringParticles = {}
  end)

  --// Extra cleanup for previous versions where Auto Kill connections were local.
  --// This only disconnects connections that look like Doca V1 Auto Kill closures.
  pcall(function()
    if getconnections and debug and debug.getupvalue then
      local function LooksLikeDocaAutoKill(Function)
        if type(Function) ~= "function" then
          return false
        end
        for Index = 1, 80 do
          local Name = debug.getupvalue(Function, Index)
          if not Name then
            break
          end
          if Name == "DocaStartKillingActive" or Name == "DocaAutoKillInPartEnabled" or Name == "DocaAutoKillPart" or Name == "DocaMoveMeToKillPart" then
            return true
          end
        end
        return false
      end

      for _, Signal in ipairs({RunService.Heartbeat, RunService.Stepped, RunService.RenderStepped}) do
        for _, Connection in ipairs(getconnections(Signal)) do
          local Function = Connection.Function or Connection.func or Connection.callback
          if LooksLikeDocaAutoKill(Function) then
            if Connection.Disable then
              Connection:Disable()
            elseif Connection.Disconnect then
              Connection:Disconnect()
            end
          end
        end
      end
    end
  end)
end

DocaHardRuntimeCleanup()

