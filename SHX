  local function SetCornerRadius(Object, Radius)
    if not Object then return end
    local Corner = Object:FindFirstChildOfClass("UICorner")
    if not Corner then
      Corner = Instance.new("UICorner")
      Corner.Parent = Object
    end
    Corner.CornerRadius = UDim.new(0, Radius)
  end

  local function ApplyAccent(Color)
    Beauty.Accent = Color
    Custom.ColorRGB = Color
    if TextLabel1 then
      TextLabel1.TextColor3 = Color
      local Stroke = TextLabel1:FindFirstChildOfClass("UIStroke")
      if Stroke then Stroke.Color = Color end
    end

    for _, v in ipairs(SpeedHubXGui:GetDescendants()) do
      if v:IsA("UIStroke") then
        local ParentName = v.Parent and v.Parent.Name or ""
        if ParentName == "Dropdown" or ParentName == "SelectOptionsFrame" or ParentName == "DropdownSelect" or ParentName == "SliderInput" or ParentName == "CloseConfirmFrame" then
          v.Color = Color
        end
      elseif v:IsA("Frame") then
        if v.Name == "SliderInput" or v.Name == "SliderDraggable" or v.Name == "SliderCircle" or v.Name == "ChooseFrame" then
          v.BackgroundColor3 = Color
        end
      elseif v:IsA("ImageLabel") then
        if v.Name == "WarningIcon" or v.Name == "OptionImg" then
          v.ImageColor3 = Color
        end
      end
    end

    for _, Holder in ipairs(SpeedHubXGui:GetDescendants()) do
      if Holder.Name == "RedCornerGlow" then
        for _, Line in ipairs(Holder:GetChildren()) do
          if Line:IsA("Frame") then
            Line.BackgroundColor3 = Color
          end
        end
      end
    end
  end

  local function ApplyRoundness(Radius)
    Radius = math.clamp(tonumber(Radius) or 10, 0, 24)
    SetCornerRadius(Main, Radius)
    SetCornerRadius(DropShadow, Radius)
    SetCornerRadius(LayersTab, math.clamp(Radius - 3, 4, 20))
    SetCornerRadius(Layers, math.clamp(Radius - 3, 4, 20))
    SetCornerRadius(DropdownSelect, math.clamp(Radius - 4, 4, 18))

    for _, v in ipairs(SpeedHubXGui:GetDescendants()) do
      if v:IsA("Frame") then
        if v.Name == "Button" or v.Name == "Toggle" or v.Name == "Slider" or v.Name == "Dropdown" or v.Name == "Paragraph" or v.Name == "SectionReal" or v.Name == "SelectOptionsFrame" or v.Name == "SliderInput" then
          SetCornerRadius(v, math.clamp(Radius - 6, 4, 16))
        end
      elseif v:IsA("TextButton") then
        if v.Name == "YesButton" or v.Name == "NoButton" then
          SetCornerRadius(v, math.clamp(Radius - 4, 6, 18))
        end
      end
    end
  end

  local function ApplyGlass(Value)
    Beauty.Glass = Value and true or false
    local MainTransparency = Beauty.Glass and 0.18 or 0.1
    local CardTransparency = Beauty.Glass and 0.9 or 0.935

    TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
      BackgroundTransparency = MainTransparency
    }):Play()

    for _, v in ipairs(SpeedHubXGui:GetDescendants()) do
      if v:IsA("Frame") and (v.Name == "Button" or v.Name == "Toggle" or v.Name == "Slider" or v.Name == "Dropdown" or v.Name == "Paragraph" or v.Name == "SectionReal") then
        TweenService:Create(v, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
          BackgroundTransparency = CardTransparency
        }):Play()
      end
    end
  end

