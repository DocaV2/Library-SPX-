  local function SetTitleRGB(Value)
    Beauty.TitleRGB = Value and true or false
    if Beauty.TitleConnection then
      Beauty.TitleConnection:Disconnect()
      Beauty.TitleConnection = nil
    end

    if Beauty.TitleRGB then
      Beauty.TitleConnection = RunService.RenderStepped:Connect(function()
        local Color = Color3.fromHSV((tick() * 0.18) % 1, 1, 1)
        if TextLabel1 then
          TextLabel1.TextColor3 = Color
          local Stroke = TextLabel1:FindFirstChildOfClass("UIStroke")
          if Stroke then Stroke.Color = Color end
        end
      end)
    else
      ApplyAccent(Beauty.Accent)
    end
  end

  local function SetParticles(Value)
    Beauty.Particles = Value and true or false

    if Beauty.ParticleConnection then
      Beauty.ParticleConnection:Disconnect()
      Beauty.ParticleConnection = nil
    end
    if Beauty.ParticleFolder then
      Beauty.ParticleFolder:Destroy()
      Beauty.ParticleFolder = nil
    end
    if not Beauty.Particles then return end

    Beauty.ParticleFolder = Instance.new("Folder")
    Beauty.ParticleFolder.Name = "BeautyParticles"
    Beauty.ParticleFolder.Parent = Main

    local Particles = {}
    for i = 1, 16 do
      local Dot = Instance.new("Frame")
      Dot.Name = "Particle"
      Dot.BackgroundColor3 = Beauty.Accent
      Dot.BackgroundTransparency = 0.72
      Dot.BorderSizePixel = 0
      Dot.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
      Dot.Position = UDim2.new(math.random(), 0, math.random(), 0)
      Dot.ZIndex = (Main.ZIndex or 1) + 1
      Dot.Parent = Beauty.ParticleFolder
      SetCornerRadius(Dot, 50)
      Particles[i] = {
        Object = Dot,
        Speed = math.random(8, 18) / 10000,
        Offset = math.random()
      }
    end

    Beauty.ParticleConnection = RunService.RenderStepped:Connect(function()
      if not Beauty.ParticleFolder or not Beauty.ParticleFolder.Parent then return end
      for _, Particle in ipairs(Particles) do
        local Dot = Particle.Object
        if Dot and Dot.Parent then
          local X = (Dot.Position.X.Scale + Particle.Speed) % 1
          local Y = 0.5 + math.sin(tick() * 0.7 + Particle.Offset * 6.28) * 0.42
          Dot.Position = UDim2.new(X, 0, Y, 0)
          Dot.BackgroundColor3 = Beauty.Accent
        end
      end
    end)
  end

