local Custom = {} do
  Custom.ColorRGB = Color3.fromRGB(250, 7, 7)

  function Custom:Create(Name, Properties, Parent)
    local _instance = Instance.new(Name)

    for i, v in pairs(Properties) do
      _instance[i] = v
    end

    if Parent then
      _instance.Parent = Parent
    end

    return _instance
  end



  --// Red corner highlight helper (only corners, no black overlay)
  function Custom:AddCornerGlow(Parent, Config)
    Config = Config or {}
    if not Parent then return nil end

    local Color = Config.Color or Custom.ColorRGB or Color3.fromRGB(255, 40, 40)
    local Length = Config.Length or 14
    local Thick = Config.Thickness or 2
    local Offset = Config.Offset or 1
    local Transparency = Config.Transparency or 0.05
    local BaseZ = Parent.ZIndex or 1
    local Z = Config.ZIndex or (BaseZ + 2)

    local Old = Parent:FindFirstChild("RedCornerGlow")
    if Old then Old:Destroy() end

    local Holder = Instance.new("Frame")
    Holder.Name = "RedCornerGlow"
    Holder.BackgroundTransparency = 1
    Holder.BorderSizePixel = 0
    Holder.Size = UDim2.new(1, 0, 1, 0)
    Holder.Position = UDim2.new(0, 0, 0, 0)
    Holder.ZIndex = Z
    Holder.Active = false
    Holder.Parent = Parent

    local function Line(Name, Pos, Size)
      local F = Instance.new("Frame")
      F.Name = Name
      F.BackgroundColor3 = Color
      F.BackgroundTransparency = Transparency
      F.BorderSizePixel = 0
      F.Position = Pos
      F.Size = Size
      F.ZIndex = Z
      F.Active = false
      F.Parent = Holder

      local Corner = Instance.new("UICorner")
      Corner.CornerRadius = UDim.new(0, Thick)
      Corner.Parent = F
      return F
    end

    Line("LT_H", UDim2.new(0, Offset, 0, Offset), UDim2.new(0, Length, 0, Thick))
    Line("LT_V", UDim2.new(0, Offset, 0, Offset), UDim2.new(0, Thick, 0, Length))

    Line("RT_H", UDim2.new(1, -Length - Offset, 0, Offset), UDim2.new(0, Length, 0, Thick))
    Line("RT_V", UDim2.new(1, -Thick - Offset, 0, Offset), UDim2.new(0, Thick, 0, Length))

    Line("LB_H", UDim2.new(0, Offset, 1, -Thick - Offset), UDim2.new(0, Length, 0, Thick))
    Line("LB_V", UDim2.new(0, Offset, 1, -Length - Offset), UDim2.new(0, Thick, 0, Length))

    Line("RB_H", UDim2.new(1, -Length - Offset, 1, -Thick - Offset), UDim2.new(0, Length, 0, Thick))
    Line("RB_V", UDim2.new(1, -Thick - Offset, 1, -Length - Offset), UDim2.new(0, Thick, 0, Length))

    return Holder
  end

  function Custom:EnabledAFK()
    Player.Idled:Connect(function()
      VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
      task.wait(1)
      VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
  end

  function Custom:GenNumber(Num)
    local List = {}

    for _ = 1, Num do
        table.insert(List, math.random(0, 9))
    end

    return table.concat(List)
  end

  function Custom:Decryption(Enc)
    local List = {}

    for num in string.gmatch(Enc, "[^,]+") do
      local Ori = tonumber(num) - 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9 + 9e9

      table.insert(List, Ori)
    end

    return tonumber(table.concat(List))
  end
end

