  local function CloseLibraryAnimated()
    if ConfirmClosing then return end
    ConfirmClosing = true
    ConfirmOpen = false

    task.spawn(function()
      Speed_Library:_RunUnload()
    end)

    ConfirmOverlay.Visible = false
    Open_Close.Visible = false

    local EndPosition = GetTopHiddenPosition()
    local ShrinkSize = UDim2.new(0, math.floor((FinalWindowSize.X.Offset > 0 and FinalWindowSize.X.Offset or Main.AbsoluteSize.X) * 0.90), 0, math.floor((FinalWindowSize.Y.Offset > 0 and FinalWindowSize.Y.Offset or Main.AbsoluteSize.Y) * 0.90))

    TweenService:Create(DropShadowHolder, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
      Position = EndPosition
    }):Play()

    TweenService:Create(Main, TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
      BackgroundTransparency = 1,
      Size = ShrinkSize
    }):Play()

    TweenService:Create(DropShadow, TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
      ImageTransparency = 1,
      Size = ShrinkSize
    }):Play()

    task.delay(0.36, function()
