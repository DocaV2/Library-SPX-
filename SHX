      Options = {"Crimson", "Cherry", "Ruby", "Rose", "Orange", "Gold", "Lime", "Emerald", "Mint", "Cyan", "Sky", "Blue", "Violet", "Purple", "Pink", "White"},
      Default = {"Crimson"},
      Callback = function(Value)
        local Pick = typeof(Value) == "table" and Value[1] or Value
        ApplyAccent(ThemeColors[Pick] or ThemeColors.Crimson)
      end
    })

    ThemeSection:AddToggle({
      Title = "RGB Title",
      Content = "Animated rainbow color only for the title description text",
      Default = false,
      Callback = function(Value)
        SetTitleRGB(Value)
      end
    })


    local WindowSection = SettingsTab:AddSection("Window", true)
    WindowSection:AddSlider({
      Title = "Corner Radius",
      Content = "Makes the main window and cards rounder",
      Increment = 1,
      Min = 4,
      Max = 24,
      Default = 14,
      Callback = function(Value)
        ApplyRoundness(Value)
      end
    })

    WindowSection:AddSlider({
      Title = "Window Transparency",
      Content = "Controls only the main window transparency",
      Increment = 0.01,
      Min = 0,
      Max = 0.45,
      Default = 0.1,
      Callback = function(Value)
        TweenService:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
          BackgroundTransparency = Value
        }):Play()
      end
    })

    WindowSection:AddToggle({
      Title = "Glass Cards",
      Content = "Softer transparent card style for buttons, toggles, sliders and dropdowns",
      Default = false,
      Callback = function(Value)
        ApplyGlass(Value)
      end
    })

    local EffectsSection = SettingsTab:AddSection("Effects", true)
    EffectsSection:AddToggle({
      Title = "Soft Particles",
      Content = "Small animated particles inside the window background",
      Default = false,
      Callback = function(Value)
        SetParticles(Value)
      end
    })

    EffectsSection:AddButton({
      Title = "Apply Premium Style",
      Content = "Applies rounded corners, accents, glow and clean fonts",
      Callback = function()
        ApplyPremiumStyle()
      end
    })

    local TabSection = SettingsTab:AddSection("Tabs", true)
    TabSection:AddButton({
      Title = "Auto Fit Tabs",
      Content = "Automatically resizes the tab frame for long tab names",
      Callback = function()
        AutoResizeTabs()
      end
    })

    TabSection:AddSlider({
      Title = "Tab Frame Width",
      Content = "Manual width for longer tab names",
      Increment = 5,
      Min = 100,
      Max = 260,
      Default = CurrentTabWidth,
      Callback = function(Value)
        ApplyTabWidth(Value, true)
      end
    })

    local LayoutSection = SettingsTab:AddSection("Layout", true)
    LayoutSection:AddSlider({
      Title = "UI Scale",
      Content = "Changes the whole library size without resizing tabs manually",
      Increment = 0.01,
      Min = 0.75,
      Max = 1.35,
      Default = 1,
      Callback = function(Value)
        ApplyUIScale(Value)
      end
    })

    LayoutSection:AddToggle({
      Title = "Compact Mode",
      Content = "Makes sections closer together so more functions fit on screen",
      Default = false,
      Callback = function(Value)
        ApplyCompactMode(Value)
      end
    })

    LayoutSection:AddSlider({
      Title = "Text Size",
      Content = "Changes most library text size",
      Increment = 1,
      Min = 10,
      Max = 18,
      Default = 13,
      Callback = function(Value)
        ApplyTextSize(Value)
      end
    })

    local CardsSection = SettingsTab:AddSection("Cards", true)
    CardsSection:AddSlider({
      Title = "Card Transparency",
      Content = "Controls transparency for buttons, toggles, sliders and dropdown cards",
      Increment = 0.01,
      Min = 0.86,
      Max = 0.98,
      Default = 0.935,
      Callback = function(Value)
        ApplyCardTransparency(Value)
      end
    })

    CardsSection:AddButton({
      Title = "Reset Style",
      Content = "Returns the library style to a clean default look",
      Callback = function()
        ResetLibraryStyle()
      end
    })

    local CleanSection = SettingsTab:AddSection("Clean Fixes", true)
    CleanSection:AddParagraph({
      Title = "Included",
      Content = "No red tab line, white close warning text, fixed slider input, bigger thin minus, auto tab width, UI scale, compact mode, text size and card transparency."
    })

    ApplyPremiumStyle()
    AutoResizeTabs()
  end)

  return Tabs
end

return Speed_Library
