  function Custom:GetSectionImage(Title)
    local Text = tostring(Title or ""):lower():gsub("[^%w]", "")
    if self.SectionImages[Text] then
      return self.SectionImages[Text]
    end

    if Text:find("discord") then return self.SectionImages.discord end
    if Text:find("local") or Text:find("player") then return self.SectionImages.localplayer end
    if Text:find("auto") then return self.SectionImages.autotools end
    if Text:find("treadmill") then return self.SectionImages.treadmill end
    if Text:find("rock") or Text:find("boulder") then return self.SectionImages.rocks end
    if Text:find("bar") or Text:find("bench") or Text:find("squat") or Text:find("pull") then return self.SectionImages.killer end
    if Text:find("rebirth") or Text:find("regular") or Text:find("pack") then return self.SectionImages.regularfarm end
    if Text:find("white") or Text:find("kill") or Text:find("target") or Text:find("death") then return self.SectionImages.killer end
    if Text:find("shop") then return self.SectionImages.shop end
    if Text:find("calc") or Text:find("damage") or Text:find("glitch") then return self.SectionImages.damagedurabilitycalculator end
    if Text:find("stat") then return self.SectionImages.stats end
    if Text:find("music") then return self.SectionImages.music end
    if Text:find("teleport") then return self.SectionImages.teleport end
    if Text:find("setting") then return self.SectionImages.settings end
    if Text:find("misc") then return self.SectionImages.misc end

    return self.SectionImages.misc
  end


